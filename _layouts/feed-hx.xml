---
layout: compress
---
{% assign posts = site.posts | where: 'lang', page.lang %}{% if page.content_type %}{% assign posts = posts | where: 'content_type', page.content_type %}{% endif %}{% if page.content_type == 'signal-brief' %}{% assign feed_title = 'HECAVEX Signal Brief' %}{% if page.lang == 'lt' %}{% assign feed_subtitle = 'Trumpos, šaltiniais paremtos kibernetinio saugumo signalų apžvalgos.' %}{% else %}{% assign feed_subtitle = 'Concise, source-led briefings on vulnerabilities, incidents and developments defenders should track.' %}{% endif %}{% else %}{% capture feed_title %}HECAVEX — {{ site.data.hecavex[page.lang].descriptor }}{% endcapture %}{% assign feed_subtitle = site.data.hecavex[page.lang].supporting %}{% endif %}<?xml version="1.0" encoding="utf-8"?><feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ page.lang }}"><id>{{ page.home | absolute_url }}</id><title>{{ feed_title | xml_escape }}</title><subtitle>{{ feed_subtitle | xml_escape }}</subtitle><updated>{{ site.time | date_to_xmlschema }}</updated><link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/><link rel="alternate" type="text/html" hreflang="{{ page.lang }}" href="{{ page.home | absolute_url }}"/><author><name>HECAVEX</name><uri>https://hecavex.com</uri></author>{% for post in posts limit: 20 %}<entry><title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url }}"/><id>{{ post.url | absolute_url }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated><summary>{{ post.description | xml_escape }}</summary></entry>{% endfor %}</feed>
