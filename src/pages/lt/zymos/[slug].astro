---
import TaxonomyResults from '../../../components/TaxonomyResults.astro';
import { getLocalizedPosts, minIndexedTagPosts, slugify, tagLabel } from '../../../lib/site';
export async function getStaticPaths() {
  const [posts, alternatePosts] = await Promise.all([getLocalizedPosts('lt'), getLocalizedPosts('en')]);
  const tags = new Map(posts.flatMap((post) => post.tags).map((tag) => [slugify(tag), tag]));
  const alternateCounts = new Map<string, number>();
  for (const tag of alternatePosts.flatMap((post) => post.tags)) {
    const slug = slugify(tag);
    alternateCounts.set(slug, (alternateCounts.get(slug) ?? 0) + 1);
  }
  return [...tags].map(([slug, label]) => ({
    params: { slug },
    props: {
      slug,
      label: tagLabel(label, 'lt'),
      posts: posts.filter((post) => post.tags.some((tag) => slugify(tag) === slug)),
      alternatePath: (alternateCounts.get(slug) ?? 0) >= minIndexedTagPosts ? `/en/tags/${slug}/` : undefined
    }
  }));
}
const { slug, label, posts, alternatePath } = Astro.props;
---
<TaxonomyResults lang="lt" kind="tag" {slug} {label} {posts} {alternatePath} />
