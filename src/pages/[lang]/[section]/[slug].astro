---
import { render } from 'astro:content';
import ContentOutline from '../../../components/ContentOutline.astro';
import PostCard from '../../../components/PostCard.astro';
import type { OutlineItem } from '../../../data/page-context';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { dateText, findTranslation, getLocalizedPosts, getPublicPosts, imageAlt, imagePath, labelForPost, slugify, type Post } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return posts.map((post) => {
    const [lang, section, slug] = post.url.split('/').filter(Boolean);
    return { params: { lang, section, slug }, props: { post } };
  });
}

interface Props { post: Post; }
const { post } = Astro.props as Props;
const { Content, headings } = await render(post.entry);
const data = post.entry.data as typeof post.entry.data & Record<string, unknown>;
const translation = await findTranslation(post);
const localized = await getLocalizedPosts(post.lang);
const position = localized.findIndex((candidate) => candidate.url === post.url);
const newer = position > 0 ? localized[position - 1] : undefined;
const older = position >= 0 && position < localized.length - 1 ? localized[position + 1] : undefined;
const related = localized.filter((candidate) => candidate.url !== post.url && candidate.categories.some((category) => post.categories.includes(category))).slice(0, 3);
const evidenceBearing = ['investigation', 'malware-analysis', 'incident-analysis', 'technical-analysis', 'technical-guide'].includes(post.contentType);
const hero = imagePath(post, 'hero');
const social = imagePath(post, 'social');
const alt = imageAlt(post);
const image = typeof post.image === 'object' ? post.image : undefined;
const methods = Array.isArray(data.methods) ? data.methods.map(String) : [];
const findings = Array.isArray(data.key_findings) ? data.key_findings.map(String) : [];
const updates = Array.isArray(data.updates) ? data.updates as Array<{ date: Date; note: string }> : [];
const stableId = String(data.research_id ?? `HCVX-${post.translationKey.toUpperCase().replace(/[^A-Z0-9]+/g, '-')}`);
const generatedOutlineHeadings: OutlineItem[] = [
  ...(findings.length > 0 ? [{ depth: 2, slug: 'findings-title', text: post.lang === 'lt' ? 'Ką rodo įrodymai' : 'What the evidence supports' }] : []),
  ...(evidenceBearing ? [{ depth: 2, slug: 'record-title', text: post.lang === 'lt' ? 'Tyrimo ribos' : 'Research boundaries' }] : [])
];
const bodyOutlineHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3) as OutlineItem[];
const trackedOutlineHeadings: OutlineItem[] = [
  { depth: 2, slug: 'article-start', text: post.lang === 'lt' ? 'Apžvalga' : 'Overview' },
  ...generatedOutlineHeadings,
  ...bodyOutlineHeadings
];
const condensedOutline = trackedOutlineHeadings.length > 40;
const outlineHeadings = condensedOutline ? trackedOutlineHeadings.filter((heading) => heading.depth === 2) : trackedOutlineHeadings;
const showOutline = data.toc !== false && trackedOutlineHeadings.length > 1;
const wideProse = data.prose_width === 'wide';
const canonical = new URL(post.url, Astro.site).href;
const sectionPath = post.publicationClass === 'signal-brief'
  ? `/${post.lang}/${post.lang === 'lt' ? 'apzvalgos' : 'briefings'}/`
  : `/${post.lang}/${post.lang === 'lt' ? 'tyrimai' : 'research'}/`;
const sectionLabel = post.publicationClass === 'signal-brief'
  ? (post.lang === 'lt' ? 'Signalų apžvalgos' : 'Signal Briefs')
  : (post.lang === 'lt' ? 'Tyrimai' : 'Research');
---
<BaseLayout lang={post.lang} title={post.title} seoTitle={post.seoTitle} keywords={post.seoKeywords.length > 0 ? post.seoKeywords : post.tags} articleSection={labelForPost(post)} description={post.description} canonicalPath={post.url} alternatePath={translation?.url} image={social} imageAlt={alt || `${post.title} social preview`} type="Article" published={post.date} modified={post.updated ?? post.date}>
  <article class="shell article-shell">
    <nav class="article-breadcrumb" aria-label={post.lang === 'lt' ? 'Publikacijos kelias' : 'Publication path'}>
      <a href={`/${post.lang}/`}>HECAVEX</a><span aria-hidden="true">/</span><a href={sectionPath}>{sectionLabel}</a><span aria-hidden="true">/</span><span aria-current="page">{post.title}</span>
    </nav>
    <div id="article-reading" class:list={['article-reading-layout', { 'article-reading-layout--with-outline': showOutline }]}>
    <header id="article-start" class="article-head" data-outline-heading="true" data-outline-label={post.lang === 'lt' ? 'Apžvalga' : 'Overview'}>
      <div class="article-edition"><span>{post.lang === 'lt' ? 'LIETUVIŲ' : 'ENGLISH'}</span>{translation && <a href={translation.url} hreflang={translation.lang}>{post.lang === 'lt' ? 'Read in English' : 'Skaityti lietuviškai'} →</a>}</div>
      <p class="eyebrow">{labelForPost(post)}</p>
      <h1>{post.title}</h1>
      <p class="article-deck">{post.description}</p>
      <div class="article-meta"><span>{post.lang === 'lt' ? 'Paskelbta' : 'Published'} <time datetime={post.date.toISOString()}>{dateText(post.date)}</time></span>{post.updated && post.updated.valueOf() !== post.date.valueOf() && <span>{post.lang === 'lt' ? 'Atnaujinta' : 'Updated'} <time datetime={post.updated.toISOString()}>{dateText(post.updated)}</time></span>}<span>{post.readingMinutes} {post.lang === 'lt' ? 'min. skaitymo' : 'min read'}</span><span>{post.lang === 'lt' ? 'Autorius' : 'By'} <a href={post.lang === 'lt' ? '/lt/apie/' : '/en/about/'}>Deividas Lis</a></span></div>
      <dl class="article-signals"><div><dt>{post.lang === 'lt' ? 'Turinio tipas' : 'Content type'}</dt><dd>{labelForPost(post)}</dd></div><div><dt>{post.lang === 'lt' ? 'Pasitikėjimas' : 'Confidence'}</dt><dd>{String(data.confidence ?? 'not stated')}</dd></div><div><dt>TLP</dt><dd>{String(data.tlp ?? 'clear').toUpperCase()}</dd></div></dl>
      {hero && <figure class="article-hero"><img src={hero} alt={alt} width={image?.hero_width ?? image?.width ?? 1200} height={image?.hero_height ?? image?.height ?? 630} loading="eager" fetchpriority="high" />{alt && <figcaption>{alt}</figcaption>}</figure>}
    </header>

      {showOutline && <ContentOutline lang={post.lang} headings={outlineHeadings} scopeId="article-reading" condensed={condensedOutline} />}
      <div class:list={['article-body', 'prose', { 'article-body--wide': wideProse }]}>
        {post.contentType === 'signal-brief' && <aside class="brief-record"><span>HECAVEX SIGNAL BRIEF · #{String(data.issue ?? '—')}</span><dl><div><dt>{post.lang === 'lt' ? 'Aprėptis' : 'Coverage'}</dt><dd>{String(data.coverage_start ?? '—')} — {String(data.coverage_end ?? '—')}</dd></div><div><dt>{post.lang === 'lt' ? 'Informacijos riba' : 'Information cut-off'}</dt><dd>{String(data.information_cutoff ?? '—')}</dd></div></dl></aside>}
        {findings.length > 0 && <section class="editorial-summary" aria-labelledby="findings-title"><p class="eyebrow">{post.lang === 'lt' ? 'Esminės išvados' : 'Key findings'}</p><h2 id="findings-title">{post.lang === 'lt' ? 'Ką rodo įrodymai' : 'What the evidence supports'}</h2><ul>{findings.map((finding) => <li>{finding}</li>)}</ul></section>}
        {evidenceBearing && <section class="research-record" aria-labelledby="record-title"><p class="eyebrow">PUBLICATION RECORD</p><h2 id="record-title">{post.lang === 'lt' ? 'Tyrimo ribos' : 'Research boundaries'}</h2><dl><div><dt>ID</dt><dd class="mono">{stableId}</dd></div><div><dt>{post.lang === 'lt' ? 'Versija' : 'Version'}</dt><dd>{String(data.research_version ?? '1.0')}</dd></div><div><dt>{post.lang === 'lt' ? 'Būsena' : 'Status'}</dt><dd>{String(data.research_status ?? 'published')}</dd></div><div><dt>{post.lang === 'lt' ? 'Įrodymų pagrindas' : 'Evidence basis'}</dt><dd>{String(data.evidence_basis ?? (post.lang === 'lt' ? 'Publikacijoje nurodyti pirminiai ir vieši šaltiniai.' : 'Primary and public sources identified in the publication.'))}</dd></div><div><dt>{post.lang === 'lt' ? 'Apimtis' : 'Scope'}</dt><dd>{String(data.scope ?? '—')}</dd></div><div><dt>{post.lang === 'lt' ? 'Ribotumai' : 'Limitations'}</dt><dd>{String(data.limitations ?? '—')}</dd></div><div><dt>{post.lang === 'lt' ? 'Metodai' : 'Methods'}</dt><dd>{methods.length ? methods.join(' · ') : post.lang === 'lt' ? 'Šaltinių tikrinimas · analitinis vertinimas' : 'Source validation · analytical assessment'}</dd></div><div><dt>TLP</dt><dd>{String(data.tlp ?? 'clear').toUpperCase()}</dd></div></dl>{data.research_bundle && <a href={String(data.research_bundle)}>{post.lang === 'lt' ? 'Atverti tyrimo artefaktus' : 'Open research artefacts'} ↗</a>}</section>}
        <Content />
      </div>
    </div>

    {updates.length > 0 && <section class="update-history"><p class="eyebrow">{post.lang === 'lt' ? 'Atnaujinimų istorija' : 'Update history'}</p><ol>{updates.map((update) => <li><time datetime={new Date(update.date).toISOString()}>{dateText(new Date(update.date))}</time><p>{update.note}</p></li>)}</ol></section>}
    <aside class="citation-block"><p class="eyebrow">{post.lang === 'lt' ? 'Citavimas' : 'Citation'}</p><p>Lis, Deividas. “{post.title}.” HECAVEX, {dateText(post.date)}. <a href={post.url}>{canonical}</a>.</p></aside>
    {!translation && <p class="translation-note">{post.lang === 'lt' ? 'Šio turinio vertimas dar neparengtas.' : 'This content is currently available only in its original language.'}</p>}
    <footer class="article-footer">
      {post.categories.length > 0 && <div class="taxonomy-row"><strong>{post.lang === 'lt' ? 'Kategorijos' : 'Categories'}</strong>{post.categories.map((category) => <a href={`/${post.lang}/${post.lang === 'lt' ? 'kategorijos' : 'categories'}/${category}/`}>{category}</a>)}</div>}
      {post.tags.length > 0 && <div class="taxonomy-row"><strong>{post.lang === 'lt' ? 'Žymos' : 'Tags'}</strong>{post.tags.map((tag) => <a href={`/${post.lang}/${post.lang === 'lt' ? 'zymos' : 'tags'}/${slugify(tag)}/`}>{tag}</a>)}</div>}
      <div class="article-share"><strong>{post.lang === 'lt' ? 'Dalytis' : 'Share'}</strong><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}>LinkedIn</a><a href={`mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent(canonical)}`}>Email</a><button type="button" data-copy-link data-success={post.lang === 'lt' ? 'Nukopijuota' : 'Copied'}>{post.lang === 'lt' ? 'Kopijuoti nuorodą' : 'Copy link'}</button></div>
      <p class="content-license">{post.lang === 'lt' ? 'Jei nenurodyta kitaip, autoriaus tekstas platinamas pagal ' : "Unless stated otherwise, the author's text is licensed under "}<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
    </footer>

    {related.length > 0 && <section class="related-posts"><header class="section-head"><div><p class="eyebrow">{post.lang === 'lt' ? 'Susiję' : 'Related'}</p><h2>{post.lang === 'lt' ? 'Susijusios publikacijos' : 'Related research'}</h2></div></header><div class="post-grid">{related.map((candidate) => <PostCard post={candidate} />)}</div></section>}
    <nav class="article-navigation" aria-label={post.lang === 'lt' ? 'Publikacijų navigacija' : 'Publication navigation'}>{newer && <a href={newer.url}><span>← {post.lang === 'lt' ? 'Naujesnė' : 'Newer'}</span><strong>{newer.cardTitle}</strong></a>}{older && <a href={older.url}><span>{post.lang === 'lt' ? 'Ankstesnė' : 'Older'} →</span><strong>{older.cardTitle}</strong></a>}</nav>
  </article>
</BaseLayout>
