---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SpeakingInvitation from '../../components/SpeakingInvitation.astro';
import HomeTaskRoutes from '../../components/HomeTaskRoutes.astro';
import ResearchPaths from '../../components/ResearchPaths.astro';
import { beginnerList, briefingsPath, copy, findPage, getLocalizedPosts, homeCounts, latestContentUpdate, radarUrl, researchPath, startHerePath, audienceLabel, publicationClasses, type Lang } from '../../lib/site';

export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'lt' } }]; }
const lang = Astro.params.lang as Lang;
const posts = await getLocalizedPosts(lang);
const research = posts.filter((post) => post.contentType !== 'signal-brief');
const briefings = posts.filter((post) => post.contentType === 'signal-brief');
const recent = research.slice(0, homeCounts.latest);
const basics = beginnerList(posts).slice(0, homeCounts.basics);
const latestBriefing = briefings[0];
const hx = copy[lang];
const latestUpdate = latestContentUpdate(posts);
const alternatePath = lang === 'lt' ? '/en/' : '/lt/';
const homePage = await findPage(`/${lang}/`);
if (!homePage) throw new Error(`Missing ${lang} homepage content record`);
const title = homePage.data.title;
const seoTitle = homePage.data.seo_title;
const description = homePage.data.seo_description ?? homePage.data.description;
---
<BaseLayout {lang} {title} {seoTitle} {description} canonicalPath={`/${lang}/`} {alternatePath} type="CollectionPage">
  <div class="shell home-shell">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-copy">
        <p class="eyebrow">{hx.home_eyebrow}</p>
        <h1 id="home-title">{hx.home_h1}</h1>
        <p class="hero-deck">{hx.home_deck}</p>
      </div>
      <nav class="home-discovery" aria-label={hx.home_nav_label}>
        <a class="button button--primary" href={startHerePath[lang]}>{hx.home_cta} <span aria-hidden="true">→</span></a>
        <a href={researchPath[lang]}>{hx.home_latest_link} <span aria-hidden="true">→</span></a>
        <a href={briefingsPath[lang]}>{hx.home_briefs_link} <span aria-hidden="true">→</span></a>
      </nav>
    </section>

    {basics.length > 0 && <section class="home-section home-basics" aria-labelledby="basics-title">
      <header class="section-head"><div><p class="eyebrow">{hx.home_basics_eyebrow}</p><h2 id="basics-title">{hx.home_basics_h2}</h2></div><a href={startHerePath[lang]}>{hx.home_basics_more} →</a></header>
      <ResearchPaths {lang} entries={basics.map((post) => ({ label: audienceLabel(post), post }))} variant="basics" />
    </section>}

    {recent.length > 0 && <section class="home-section home-latest" aria-labelledby="latest-title">
      <header class="section-head"><h2 id="latest-title">{hx.home_latest_h2}</h2><a href={researchPath[lang]}>{hx.view_all} →</a></header>
      <div class="post-grid home-latest-grid">{recent.map((post) => <PostCard {post} />)}</div>
    </section>}

    <HomeTaskRoutes {lang} {posts} {latestUpdate} />

    <section class="home-signal-grid">
      {latestBriefing && <div><header class="section-head"><div><p class="eyebrow">{publicationClasses['signal-brief']![lang]}</p><h2>{hx.latest_briefing}</h2></div><a href={briefingsPath[lang]}>{hx.all_briefings} →</a></header><p class="home-briefs-explainer">{hx.home_briefs_explainer}</p><PostCard post={latestBriefing} prominent /></div>}
      <aside class="radar-note"><p class="eyebrow">HECAVEX RADAR</p><h2>{hx.radar_h2}</h2><p>{hx.radar_p}</p><a class="button" href={radarUrl[lang]}>{hx.radar_open} ↗</a></aside>
    </section>

    <SpeakingInvitation {lang} />
  </div>
</BaseLayout>
