---
import { render } from 'astro:content';
import ContactEmail from '../../components/ContactEmail.astro';
import ContentOutline from '../../components/ContentOutline.astro';
import ResearchTasks from '../../components/ResearchTasks.astro';
import EnquiryDraft from '../../components/EnquiryDraft.astro';
import Glossary from '../../components/Glossary.astro';
import PageActionRail from '../../components/PageActionRail.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import ProjectDirectory from '../../components/ProjectDirectory.astro';
import SpeakerContact from '../../components/SpeakerContact.astro';
import StartHere from '../../components/StartHere.astro';
import { contactRoutesFor, pageFactsFor, researchMapFor, type OutlineItem } from '../../data/page-context';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { audienceLabel, briefingsPath, categoryPath, copy, labelForPost, startHerePath, tagsPath, dateText, getPages, getLocalizedPosts, languagePairPath, latestContentUpdate, slugify, tagLabel, taxonomy, type Lang, type PageEntry } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.flatMap((entry) => {
    const parts = entry.data.permalink.split('/').filter(Boolean);
    if (parts.length !== 2 || parts[1]?.includes('.')) return [];
    return [{ params: { lang: entry.data.lang, page: parts[1] }, props: { entry } }];
  });
}

interface Props { entry: PageEntry; }
const { entry } = Astro.props as Props;
const lang = entry.data.lang as Lang;
const hx = copy[lang];
const posts = await getLocalizedPosts(lang);
const alternatePath = await languagePairPath(entry.data.translation_key, lang);
const { Content, headings } = await render(entry);
const layout = entry.data.layout;
const pageType = entry.data.translation_key === 'about' ? 'ProfilePage'
  : ['research', 'briefings', 'archive-hx', 'taxonomy', 'start-here'].includes(layout) || ['tags', 'portfolio-projects'].includes(entry.data.translation_key) ? 'CollectionPage' : 'WebPage';
const primary = posts.filter((post) => post.publicationClass === 'primary-research');
const assessments = posts.filter((post) => post.publicationClass === 'technical-assessment');
const commentary = posts.filter((post) => post.publicationClass === 'commentary');
const briefings = posts.filter((post) => post.publicationClass === 'signal-brief');
const featured = posts.filter((post) => post.featured).slice(0, 3);
const tags = [...new Map(posts.flatMap((post) => post.tags).map((tag) => [slugify(tag), tagLabel(tag, lang)])).entries()].sort((a, b) => a[1].localeCompare(b[1], lang));
const title = entry.data.seo_title ?? entry.data.title;
const bodyOutlineHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3) as OutlineItem[];
const standardOutlineHeadings: OutlineItem[] = [{ depth: 2, slug: 'page-start', text: entry.data.title }, ...bodyOutlineHeadings];
const showActionRail = entry.data.translation_key === 'contact';
const showStandardOutline = !showActionRail && standardOutlineHeadings.length > 2;
const useCatalogueWidth = ['about', 'speaker-media', 'contact'].includes(entry.data.translation_key);
const latestUpdate = latestContentUpdate(posts);
const pageFacts = pageFactsFor(entry.data.translation_key, lang, latestUpdate ? dateText(latestUpdate) : '—');
const researchMap = researchMapFor(lang, {
  featured: featured.length,
  primary: primary.length,
  assessments: assessments.length,
  commentary: commentary.length,
  briefings: briefings.length
});
---
<BaseLayout {lang} {title} description={entry.data.seo_description ?? entry.data.description} canonicalPath={entry.data.permalink} {alternatePath} noindex={entry.data.robots?.includes('noindex')} type={pageType} modified={entry.data.last_modified_at}>
  <div class="shell page-shell">
    {layout === 'research' ? <>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} facts={pageFacts} anchorId="page-start" />
      <div class="research-layout">
        <div id="research-catalogue" class="research-catalogue">
      <p class="research-newcomer"><a href={startHerePath[lang]}>{hx.research_newcomer} →</a></p>
      <ResearchTasks {lang} {posts} />
      {featured.length > 0 && <section id="featured" class="catalogue-section catalogue-section--featured" data-outline-heading="true" data-outline-label={hx.research_featured_h2}><header class="section-head"><div><p class="eyebrow">{hx.research_featured_eyebrow}</p><h2>{hx.research_featured_h2}</h2><p>{hx.research_featured_p}</p></div></header><div class="post-grid">{featured.map((post) => <PostCard {post} prominent />)}</div></section>}
      <section id="primary" class="catalogue-section" data-outline-heading="true" data-outline-label={hx.cat_primary_h2}><header class="section-head"><div><p class="eyebrow">{hx.cat_primary_eyebrow}</p><h2>{hx.cat_primary_h2}</h2><p>{hx.cat_primary_p}</p></div></header><div class="post-grid">{primary.map((post) => <PostCard {post} />)}</div></section>
      <section id="assessments" class="catalogue-section" data-outline-heading="true" data-outline-label={hx.cat_assess_h2}><header class="section-head"><div><p class="eyebrow">{hx.cat_assess_eyebrow}</p><h2>{hx.cat_assess_h2}</h2><p>{hx.cat_assess_p}</p></div></header><div class="post-grid">{assessments.map((post) => <PostCard {post} />)}</div></section>
      <section id="commentary" class="catalogue-section" data-outline-heading="true" data-outline-label={hx.cat_comm_h2}><header class="section-head"><div><p class="eyebrow">{hx.cat_comm_eyebrow}</p><h2>{hx.cat_comm_h2}</h2><p>{hx.cat_comm_p}</p></div></header><div class="post-grid">{commentary.map((post) => <PostCard {post} />)}</div></section>
      <aside id="briefing-path" class="briefing-path" data-outline-heading="true" data-outline-label="Signal Brief"><div><p class="eyebrow">Signal Brief</p><h2>{hx.cat_brief_h2}</h2><p>{hx.cat_brief_p}</p></div><a href={briefingsPath[lang]}>{hx.cat_brief_open} →</a></aside>
        </div>
        <ContentOutline {lang} headings={researchMap} scopeId="research-catalogue" kind="research-map" topHref="#page-start" />
      </div>
    </> : layout === 'briefings' ? <>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} eyebrow="HECAVEX SIGNAL BRIEF" />
      <p class="feed-link"><a href={`${briefingsPath[lang]}feed.xml`}>{hx.briefing_rss} →</a></p>
      <h2 class="visually-hidden">{hx.briefings_list_h2}</h2>
      <div class="briefing-list">{briefings.map((post) => <PostCard {post} prominent />)}</div>
    </> : layout === 'archive-hx' ? <>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} />
      <ol class="archive-list">{posts.map((post) => <li><time datetime={post.date.toISOString()}>{post.date.toISOString().slice(0, 10)}</time><div><span>{labelForPost(post)}{post.audience === 'beginner' && <span class="audience-badge audience-badge--beginner"> · {audienceLabel(post)}</span>}</span><a href={post.url}>{post.title}</a></div></li>)}</ol>
    </> : layout === 'start-here' ? <>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} />
      <div class="prose"><Content /></div>
      <StartHere {lang} {posts} />
    </> : layout === 'taxonomy' ? <>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} />
      <div class="topic-grid">{Object.entries(taxonomy).map(([slug, labels]) => { const count = posts.filter((post) => post.categories.includes(slug)).length; return count > 0 ? <a href={categoryPath(lang, slug)}><h2>{labels[lang]}</h2><p>{count} {count === 1 ? hx.publication_count_one : hx.publication_count_other}</p><span aria-hidden="true">→</span></a> : <section aria-disabled="true"><h2>{labels[lang]}</h2><p>0 {hx.publication_count_none}</p></section>; })}</div>
    </> : entry.data.translation_key === 'tags' ? <>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} />
      <div class="tag-index">{tags.map(([slug, tag]) => <a href={`${tagsPath[lang]}${slug}/`}>{tag}</a>)}</div>
    </> : entry.data.translation_key === 'portfolio-projects' ? <>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} />
      <ProjectDirectory {lang} />
    </> : entry.data.translation_key === 'portfolio-glossary' ? <>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} />
      <Glossary {lang} />
    </> : <article id="standard-page-scope" class:list={['standard-page', { 'standard-page--with-rail': showStandardOutline || showActionRail, 'standard-page--catalogue-width': useCatalogueWidth, 'standard-page--about': entry.data.translation_key === 'about' }]}>
      <PageHeader {lang} title={entry.data.title} description={entry.data.description} facts={pageFacts} anchorId="page-start" />
      {showStandardOutline && <ContentOutline {lang} headings={standardOutlineHeadings} scopeId="standard-page-scope" condensed={standardOutlineHeadings.length > 40} />}
      {showActionRail && <PageActionRail {lang} routes={contactRoutesFor(lang)} />}
      <div class="prose">{showActionRail && <ContactEmail {lang} />}{entry.data.translation_key === 'speaker-media' && <SpeakerContact {lang} />}<Content />{showActionRail && <EnquiryDraft {lang} />}</div>
    </article>}
  </div>
</BaseLayout>
