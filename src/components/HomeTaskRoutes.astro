---
import { dateText, type Lang, type Post } from '../lib/site';
interface Props { lang: Lang; posts: Post[]; latestUpdate?: Date; }
const { lang, posts, latestUpdate } = Astro.props;
const t = (en: string, lt: string) => lang === 'lt' ? lt : en;
const safetyGuide = posts.find(post => post.translationKey === 'suspicious-sms-link-safety-guide');
const routes = [
  ...(safetyGuide ? [{ href: safetyGuide.url, title: t('Check a suspicious link safely', 'Saugiai patikrinti įtartiną nuorodą'), note: t('Read the practical guide', 'Skaityti praktinį vadovą') }] : []),
  { href: lang === 'lt' ? '/lt/tyrimai/' : '/en/research/', title: t('Investigate a threat', 'Tirti skaitmeninę grėsmę'), note: t('Research and technical assessments', 'Tyrimai ir techniniai vertinimai') },
  { href: lang === 'lt' ? '/lt/apzvalgos/' : '/en/briefings/', title: t('Catch up on the week', 'Peržvelgti savaitės signalus'), note: t('Dated Signal Briefs with sources', 'Signalų apžvalgos su datomis ir šaltiniais') },
  { href: lang === 'lt' ? '/lt/duomenys/' : '/data/', title: t('Inspect the published data', 'Peržiūrėti paskelbtus duomenis'), note: t('Citable datasets and evidence limits', 'Cituojami rinkiniai ir įrodymų ribos') },
];
---
<nav class="home-route-rail" aria-label={t('Start with your task', 'Pradėkite nuo užduoties')}>
  <h2>{t('What brings you here?', 'Ko ieškote?')}</h2>
  <ul>{routes.map(route => <li><a href={route.href}><strong>{route.title}</strong><span>{route.note}</span></a></li>)}</ul>
  <p class="home-route-updated">{t('Content updated', 'Turinys atnaujintas')}: {latestUpdate ? <time datetime={latestUpdate.toISOString()}>{dateText(latestUpdate)}</time> : '—'}</p>
</nav>
