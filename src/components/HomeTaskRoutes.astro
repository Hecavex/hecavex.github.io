---
import { briefingsPath, copy, dataPath, dateText, researchPath, type Lang, type Post } from '../lib/site';
interface Props { lang: Lang; posts: Post[]; latestUpdate?: Date; }
const { lang, posts, latestUpdate } = Astro.props;
const c = copy[lang];
const safetyGuide = posts.find(post => post.translationKey === 'suspicious-sms-link-safety-guide');
const routes = [
  ...(safetyGuide ? [{ href: safetyGuide.url, title: c.home_route_safety_title, note: c.home_route_safety_note }] : []),
  { href: researchPath[lang], title: c.home_route_research_title, note: c.home_route_research_note },
  { href: briefingsPath[lang], title: c.home_route_briefs_title, note: c.home_route_briefs_note },
  { href: dataPath[lang], title: c.home_route_data_title, note: c.home_route_data_note },
];
---
<nav class="home-route-rail" aria-label={c.home_routes_label}>
  <h2>{c.home_routes_h2}</h2>
  <ul>{routes.map(route => <li><a href={route.href}><strong>{route.title}</strong><span>{route.note}</span></a></li>)}</ul>
  <p class="home-route-updated">{c.home_routes_updated}: {latestUpdate ? <time datetime={latestUpdate.toISOString()}>{dateText(latestUpdate)}</time> : '—'}</p>
</nav>
