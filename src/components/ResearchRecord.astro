---
import { copy, dateText, type Post } from '../lib/site';
import { recordLabel } from '../lib/record-labels.mjs';

interface Props { post: Post; data: Record<string, unknown>; stableId: string; methods: string[]; artifacts: Array<{ url: string; label: string; version?: string; sha256?: string }>; reviewDate?: Date; }
const { post, data, stableId, methods, artifacts, reviewDate } = Astro.props as Props;
const c = copy[post.lang];
---
<section class="research-record" aria-labelledby="record-title"><p class="eyebrow">{c.record_publication}</p><h2 id="record-title">{c.record_boundaries}</h2><dl><div><dt>ID</dt><dd class="mono">{stableId}</dd></div><div><dt>{c.record_version}</dt><dd>{String(data.research_version ?? c.record_not_recorded)}</dd></div><div><dt>{c.record_status}</dt><dd>{recordLabel(data.research_status ?? 'published', post.lang)}</dd></div><div><dt>{c.record_evidence_basis}</dt><dd>{String(data.evidence_basis ?? (c.record_evidence_missing))}</dd></div><div><dt>{c.record_scope}</dt><dd>{String(data.scope ?? '—')}</dd></div><div><dt>{c.record_limitations}</dt><dd>{String(data.limitations ?? '—')}</dd></div><div><dt>{c.record_methods}</dt><dd>{methods.length ? methods.join(' · ') : c.record_methods_missing}</dd></div><div><dt>{c.record_review}</dt><dd>{reviewDate ? <time datetime={reviewDate.toISOString()}>{dateText(reviewDate)}</time> : c.record_not_recorded}</dd></div><div><dt>TLP</dt><dd>{String(data.tlp ?? 'clear').toUpperCase()}</dd></div></dl>{data.research_bundle && <a href={String(data.research_bundle)}>{c.record_open_artifacts} ↗</a>}{artifacts.length > 0 && <ul class="research-artifacts">{artifacts.map((artifact) => <li><a href={artifact.url}>{artifact.label} ↗</a>{artifact.version && <span> · {c.record_artifact_version}: {artifact.version}</span>}{artifact.sha256 && <code>SHA-256: {artifact.sha256}</code>}</li>)}</ul>}</section>
