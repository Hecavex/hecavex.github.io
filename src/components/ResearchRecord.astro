---
import { dateText, type Post } from '../lib/site';
import { recordLabel } from '../lib/record-labels.mjs';

interface Props { post: Post; data: Record<string, unknown>; stableId: string; methods: string[]; artifacts: Array<{ url: string; label: string; version?: string; sha256?: string }>; reviewDate?: Date; }
const { post, data, stableId, methods, artifacts, reviewDate } = Astro.props as Props;
const t = (en: string, lt: string) => post.lang === 'lt' ? lt : en;
---
<section class="research-record" aria-labelledby="record-title"><p class="eyebrow">{t('Publication record', 'Publikacijos įrašas')}</p><h2 id="record-title">{post.lang === 'lt' ? 'Tyrimo ribos' : 'Research boundaries'}</h2><dl><div><dt>ID</dt><dd class="mono">{stableId}</dd></div><div><dt>{post.lang === 'lt' ? 'Versija' : 'Version'}</dt><dd>{String(data.research_version ?? t('Not recorded', 'Neužfiksuota'))}</dd></div><div><dt>{post.lang === 'lt' ? 'Būsena' : 'Status'}</dt><dd>{recordLabel(data.research_status ?? 'published', post.lang)}</dd></div><div><dt>{post.lang === 'lt' ? 'Įrodymų pagrindas' : 'Evidence basis'}</dt><dd>{String(data.evidence_basis ?? (post.lang === 'lt' ? 'Atskiras įrodymų pagrindo įrašas neišsaugotas. Žr. straipsnyje pateiktą medžiagą ir ribotumus.' : 'No separate evidence-basis record was retained. See the material and limitations in the article.'))}</dd></div><div><dt>{post.lang === 'lt' ? 'Apimtis' : 'Scope'}</dt><dd>{String(data.scope ?? '—')}</dd></div><div><dt>{post.lang === 'lt' ? 'Ribotumai' : 'Limitations'}</dt><dd>{String(data.limitations ?? '—')}</dd></div><div><dt>{post.lang === 'lt' ? 'Metodai' : 'Methods'}</dt><dd>{methods.length ? methods.join(' · ') : post.lang === 'lt' ? 'Atskiras metodų įrašas neišsaugotas.' : 'No separate methods record was retained.'}</dd></div><div><dt>{t('Substantive review', 'Turinio peržiūra')}</dt><dd>{reviewDate ? <time datetime={reviewDate.toISOString()}>{dateText(reviewDate)}</time> : t('Not recorded', 'Neužfiksuota')}</dd></div><div><dt>TLP</dt><dd>{String(data.tlp ?? 'clear').toUpperCase()}</dd></div></dl>{data.research_bundle && <a href={String(data.research_bundle)}>{post.lang === 'lt' ? 'Atverti tyrimo artefaktus' : 'Open research artefacts'} ↗</a>}{artifacts.length > 0 && <ul class="research-artifacts">{artifacts.map((artifact) => <li><a href={artifact.url}>{artifact.label} ↗</a>{artifact.version && <span> · {t('Artifact version', 'Artefakto versija')}: {artifact.version}</span>}{artifact.sha256 && <code>SHA-256: {artifact.sha256}</code>}</li>)}</ul>}</section>
