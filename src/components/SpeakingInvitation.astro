---
import { copy, speakerPath, type Lang } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = copy[lang];
---
<section class="speaking-invitation" aria-labelledby="speaking-title">
  <div>
    <h2 id="speaking-title">{c.speaking_invite_h2}</h2>
    <p>{c.speaking_invite_p}</p>
  </div>
  <a class="button" href={speakerPath[lang]}>
    {c.speaking_invite_link} →
  </a>
</section>
