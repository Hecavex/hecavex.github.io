---
import { copy, type Lang } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = copy[lang];
const kinds = [c.enquiry_kind_speaking!, c.enquiry_kind_media!, c.enquiry_kind_research!];
const template = c.enquiry_template!;
---
<section id="prepare-request" class="enquiry-draft" data-enquiry data-language={lang} aria-labelledby="request-title">
  <h2 id="request-title">{c.enquiry_h2}</h2>
  <p>{c.enquiry_p}</p>
  <p>{c.enquiry_direct} <a href="mailto:info@hecavex.com">info@hecavex.com</a>.</p>
  <ul class="enquiry-templates">{kinds.map(kind => <li><a href={`mailto:info@hecavex.com?subject=${encodeURIComponent(kind)}&body=${encodeURIComponent(template)}`}>{kind}</a></li>)}</ul>
  <details data-enquiry-editor hidden>
    <summary>{c.enquiry_editor_summary}</summary>
    <p>{c.enquiry_editor_p}</p>
    <fieldset>
      <legend>{c.enquiry_legend}</legend>
      <label>{c.enquiry_type}<select data-field="kind">{kinds.map((kind, index) => <option value={index}>{kind}</option>)}</select></label>
      <label>{c.enquiry_topic}<input data-field="topic" maxlength="140" /></label>
      <label>{c.enquiry_event}<input data-field="event" maxlength="180" /></label>
      <label>{c.enquiry_audience}<input data-field="audience" maxlength="180" /></label>
      <label>{c.enquiry_date}<input data-field="date" maxlength="120" /></label>
      <label>{c.enquiry_location}<input data-field="location" maxlength="180" /></label>
      <label>{c.enquiry_context}<input data-field="context" maxlength="240" /></label>
    </fieldset>
    <button type="button" class="hx-button" data-prepare>{c.enquiry_prepare}</button>
    <p role="status" data-enquiry-status></p>
    <div data-enquiry-output hidden>
      <label>{c.enquiry_output}<textarea readonly rows="12" data-draft></textarea></label>
      <a class="hx-button hx-button--primary" data-open-email href="mailto:info@hecavex.com">{c.enquiry_open_email}</a>
      <p>{c.enquiry_no_app}</p>
    </div>
  </details>
</section>
<script is:inline src="/assets/js/enquiry.js" defer></script>
