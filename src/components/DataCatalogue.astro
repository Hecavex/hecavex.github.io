---
import PageHeader from './PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { copy, dataCatalogue, dataPath, localized, portfolioProjects, type Lang } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = copy[lang];
const project = (id: string) => portfolioProjects.find((entry) => entry.id === id)!;
const owner = (id: string) => project(id).nav ? localized(project(id).nav!.label, lang) : project(id).name;

const catalogues = dataCatalogue.map((catalogue) => ({
  index: catalogue.index,
  id: catalogue.id,
  name: project(catalogue.id).name,
  owner: owner(catalogue.id),
  cadence: localized(catalogue.cadence, lang),
  description: localized(catalogue.description, lang),
  links: catalogue.links.map((link) => ({ label: localized(link.label, lang), detail: localized(link.detail, lang), href: localized(link.href, lang) }))
}));
---
<BaseLayout
  lang={lang}
  title={c.data_title!}
  description={c.data_description!}
  canonicalPath={dataPath[lang]}
  alternatePath={dataPath[lang === 'lt' ? 'en' : 'lt']}
  xDefaultPath={dataPath.en}
  type="CollectionPage"
>
  <div class="shell page-shell data-catalogue">
    <PageHeader
      lang={lang}
      title={c.data_title!}
      description={c.data_header_description!}
      eyebrow={c.data_eyebrow}
    />

    <aside class="data-catalogue__boundary" aria-labelledby="catalogue-boundary-title">
      <div>
        <p class="eyebrow">{c.data_boundary_eyebrow}</p>
        <h2 id="catalogue-boundary-title">{c.data_boundary_h2}</h2>
      </div>
      <p>{c.data_boundary_p}</p>
    </aside>

    <section class="data-catalogue__section" aria-labelledby="datasets-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">{c.data_releases_eyebrow}</p>
          <h2 id="datasets-title">{c.data_releases_h2}</h2>
          <p>{c.data_releases_p}</p>
        </div>
      </header>

      <div class="data-product-list">
        {catalogues.map((catalogue) => <article id={catalogue.id} class="data-product">
          <header class="data-product__head">
            <span>{catalogue.index}</span>
            <div>
              <p class="eyebrow">{c.data_maintained_by} {catalogue.owner}</p>
              <h3>{catalogue.name}</h3>
            </div>
            <p>{catalogue.cadence}</p>
          </header>
          <p class="data-product__description">{catalogue.description}</p>
          <ul class="data-product__links">
            {catalogue.links.map((link) => <li>
              <a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>
              <small>{link.detail}</small>
            </li>)}
          </ul>
        </article>)}
      </div>
    </section>

    <section class="data-catalogue__section data-catalogue__use" aria-labelledby="using-data-title">
      <header>
        <p class="eyebrow">{c.data_notes_eyebrow}</p>
        <h2 id="using-data-title">{c.data_notes_h2}</h2>
      </header>
      <ol>
        <li><strong>{c.data_note1_title}</strong><span>{c.data_note1_text}</span></li>
        <li><strong>{c.data_note2_title}</strong><span>{c.data_note2_text}</span></li>
        <li><strong>{c.data_note3_title}</strong><span>{c.data_note3_text}</span></li>
        <li><strong>{c.data_note4_title}</strong><span>{c.data_note4_text}</span></li>
      </ol>
    </section>
  </div>
</BaseLayout>
