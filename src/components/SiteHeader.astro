---
import { copy, networkLinks, productNavigation, type Lang } from '../lib/site';

interface Props { lang: Lang; alternatePath?: string; }
const { lang, alternatePath } = Astro.props;
const t = copy[lang];
const path = Astro.url.pathname;
// Research and Signal Briefs also own their article pages.
const prefixed = ['/en/research/', '/lt/tyrimai/', '/en/briefings/', '/lt/apzvalgos/'];
const active = (href: string) => path === href || (prefixed.includes(href) && path.startsWith(href));
const current = (href: string) => path === href ? 'page' : active(href) ? 'true' : undefined;
const networkItems = networkLinks(lang);
const activeNetworkItem = networkItems.find((item) => !item.external && path.startsWith(item.href))?.id;
const sections = productNavigation[lang];
const otherLanguage = lang === 'lt' ? 'en' : 'lt';
const languageHref = alternatePath ?? `/${otherLanguage}/`;
---
<header class="site-header" data-portfolio-shell="v2">
  <div class="network-bar shell-frame">
    <a class="brand" href={`/${lang}/`}>
      <img src="/assets/img/brand/hecavex-mark.svg" alt="" width="36" height="36" />
      <span class="brand-copy"><strong>HECAVEX</strong><small>{t.brand_sub}</small></span>
    </a>
    <nav class="portfolio-navigation" aria-label={t.net_label}>
      {networkItems.map((item) => <a href={item.href} aria-current={item.id === activeNetworkItem ? 'page' : undefined}>{item.name}{item.external && <span aria-hidden="true"> ↗</span>}</a>)}
    </nav>
    <details class="mobile-navigation" data-mobile-navigation>
      <summary aria-label={t.menu_open}>
        <svg class="menu-open-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="menu-close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        <span>{t.menu_label}</span>
      </summary>
      <div class="mobile-navigation-panel">
        <nav class="mobile-product-navigation" aria-label={t.menu_sections}>
          <span class="navigation-label">{t.menu_sections}</span>
          {sections.map(([name, href]) => <a href={href} aria-current={current(href)}>{name}</a>)}
          <button type="button" class="navigation-button" data-search-open>{t.search}</button>
          <a href={languageHref} lang={otherLanguage} hreflang={otherLanguage}>{otherLanguage.toUpperCase()}</a>
        </nav>
        <nav class="mobile-portfolio-navigation" aria-label={t.menu_more}>
          <span class="navigation-label">{t.menu_more}</span>
          {networkItems.map((item) => <a href={item.href} aria-current={item.id === activeNetworkItem ? 'page' : undefined}>{item.name}{item.external && <span aria-hidden="true"> ↗</span>}</a>)}
        </nav>
      </div>
    </details>
  </div>
  <div class="product-bar shell-frame">
    <nav class="product-navigation" aria-label={t.menu_sections}>
      {sections.map(([name, href]) => <a href={href} aria-current={current(href)}>{name}</a>)}
    </nav>
    <div class="header-utilities">
      <a class="language-link" href={languageHref} lang={otherLanguage} hreflang={otherLanguage}>{otherLanguage.toUpperCase()}</a>
      <button type="button" class="search-trigger" data-search-open aria-haspopup="dialog">⌕ <span>{t.search}</span></button>
    </div>
  </div>
</header>
