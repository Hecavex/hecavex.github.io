---
import { networkNavigation, productNavigation, type Lang } from '../lib/site';

interface Props { lang: Lang; alternatePath?: string; }
const { lang, alternatePath } = Astro.props;
const path = Astro.url.pathname;
const active = (href: string) => href.endsWith('/') ? path === href || (href.includes('/research/') || href.includes('/tyrimai/')) && path.startsWith(href) : path === href;
const activeNetworkItem = path.startsWith('/data/') ? 'Data' : 'Research';
const menuLabel = lang === 'lt' ? 'Atverti navigacijos meniu' : 'Open navigation menu';
const searchLabel = lang === 'lt' ? 'Paieška' : 'Search';
const otherLanguage = lang === 'lt' ? 'EN' : 'LT';
const languageHref = alternatePath ?? (lang === 'lt' ? '/en/' : '/lt/');
---
<header class="site-header" data-portfolio-shell="v1">
  <div class="network-bar shell-frame">
    <a class="brand" href={`/${lang}/`} aria-label={lang === 'lt' ? 'HECAVEX tyrimai' : 'HECAVEX Research'}>
      <img src="/assets/img/brand/hecavex-mark.svg" alt="" width="36" height="36" />
      <span class="brand-copy"><strong>HECAVEX</strong><small>{lang === 'lt' ? 'Tyrimai / nepriklausomas leidinys' : 'Research / independent publication'}</small></span>
    </a>
    <nav class="portfolio-navigation" aria-label="HECAVEX network">
      {networkNavigation.map((item) => <a href={item.href} aria-current={item.name === activeNetworkItem ? 'page' : undefined}>{item.name}</a>)}
    </nav>
    <details class="mobile-navigation" data-mobile-navigation>
      <summary aria-label={menuLabel}>
        <svg class="menu-open-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="menu-close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        <span>{lang === 'lt' ? 'Meniu' : 'Menu'}</span>
      </summary>
      <div class="mobile-navigation-panel">
        <nav class="mobile-product-navigation" aria-label={lang === 'lt' ? 'Tyrimų skyriai' : 'Research sections'}>
          <span class="navigation-label">HECAVEX Research</span>
          {productNavigation[lang].map(([name, href]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{name}</a>)}
          <button type="button" class="navigation-button" data-search-open>{searchLabel}</button>
          <a href={languageHref} hreflang={lang === 'lt' ? 'en' : 'lt'}>{otherLanguage}</a>
        </nav>
        <nav class="mobile-portfolio-navigation" aria-label="HECAVEX network">
          <span class="navigation-label">HECAVEX network</span>
          {networkNavigation.map((item) => <a href={item.href} aria-current={item.name === activeNetworkItem ? 'page' : undefined}>{item.name}</a>)}
        </nav>
      </div>
    </details>
  </div>
  <div class="product-bar shell-frame">
    <a class="product-identity" href={`/${lang}/`}>
      <strong>HECAVEX Research</strong>
      <span>{lang === 'lt' ? 'Dvikalbis CTI leidinys' : 'Bilingual CTI publication'}</span>
    </a>
    <nav class="product-navigation" aria-label={lang === 'lt' ? 'Tyrimų skyriai' : 'Research sections'}>
      {productNavigation[lang].map(([name, href]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{name}</a>)}
    </nav>
    <div class="header-utilities">
      <a class="language-link" href={languageHref} hreflang={lang === 'lt' ? 'en' : 'lt'}>{otherLanguage}</a>
      <button type="button" class="search-trigger" data-search-open aria-haspopup="dialog">⌕ <span>{searchLabel}</span></button>
    </div>
  </div>
</header>
