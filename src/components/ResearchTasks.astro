---
import { copy, dataPath, type Lang, type Post } from '../lib/site';
interface Props { lang: Lang; posts: Post[]; }
const { lang, posts } = Astro.props;
const c = copy[lang];
const tasks = [
  { title: c.research_task_infra_title, note: c.research_task_infra_note, keys: ['unipark-smishing-campaign-infrastructure', 'infrastructure-pivoting-101-unipark'] },
  { title: c.research_task_analytic_title, note: c.research_task_analytic_note, keys: ['t1187-forced-authentication', 'evilginx-detection'] },
];
---
<details class="research-tasks">
  <summary>{c.research_tasks_summary}</summary>
  <p>{c.research_tasks_p}</p>
  {tasks.map(task => <section><h2>{task.title}</h2><p>{task.note}</p><ol>{task.keys.map(key => {
    const post = posts.find(item => item.translationKey === key);
    if (!post) throw new Error(`Missing research task publication: ${key}/${lang}`);
    return <li><a href={post.url}>{post.title}</a></li>;
  })}</ol></section>)}
  <p><a href={dataPath[lang]}>{c.research_tasks_data_link}</a>. {c.research_tasks_data_note}</p>
</details>
