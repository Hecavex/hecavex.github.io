---
import type { Lang } from '../lib/site';
export interface PageFactLink { label: string; href: string; }
export interface PageFact { label: string; value?: string; href?: string; links?: PageFactLink[]; }
interface Props { lang: Lang; title: string; description: string; eyebrow?: string; facts?: PageFact[]; }
const { lang, title, description, eyebrow = `HECAVEX / ${lang.toUpperCase()}`, facts = [] } = Astro.props;
---
<div class:list={['page-intro', { 'page-intro--with-facts': facts.length > 0 }]}>
  <header class="page-head">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-deck">{description}</p>
  </header>
  {facts.length > 0 && <dl class="page-facts">
    {facts.map((fact) => <div>
      <dt>{fact.label}</dt>
      <dd>
        {fact.links?.map((link, index) => <>{index > 0 && <span aria-hidden="true"> · </span>}<a href={link.href}>{link.label}</a></>)}
        {!fact.links && fact.href && <a href={fact.href}>{fact.value}</a>}
        {!fact.links && !fact.href && fact.value}
      </dd>
    </div>)}
  </dl>}
</div>
