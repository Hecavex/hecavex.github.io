---
import { copy, dateText, type Lang, type Post } from '../lib/site';
import { citationPath } from '../lib/publication-citations.mjs';
interface Props { lang: Lang; entries: { label: string; post: Post }[]; variant?: 'default' | 'basics'; }
const { lang, entries, variant = 'default' } = Astro.props;
const basics = variant === 'basics';
---
<ul class:list={['research-paths', { 'research-paths--basics': basics }]}>
  {entries.map(({ label, post }) => <li class="research-path">
    <p class="research-path-label">{label}</p>
    <h3><a href={post.url}>{post.cardTitle}</a></h3>
    <p class="research-path-summary">{basics ? post.summary ?? post.description : post.description}</p>
    <div class="research-path-record"><span><time datetime={post.date.toISOString()}>{dateText(post.date)}</time> · {post.readingMinutes} {copy[lang].minutes}</span>{!basics && <a href={citationPath(post, 'bib')} download aria-label={`${lang === 'lt' ? 'Atsisiųsti BibTeX citatą' : 'Download BibTeX citation'}: ${post.title}`}>BibTeX</a>}</div>
  </li>)}
</ul>
