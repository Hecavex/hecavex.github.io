{
  "name": "hecavex-research",
  "version": "3.0.0",
  "description": "HECAVEX bilingual cyber threat intelligence publication",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && npm run check:decision-packs && npm run check:favicons && npm run check:editorial-assets && npm run build:astro && npm run build:media-pdfs && npm run build:finalize",
    "check:decision-packs": "node scripts/build-decision-packs.mjs --check",
    "build:astro": "astro check && astro build",
    "build:finalize": "node scripts/finalize-build.mjs dist",
    "build:media-pdfs": "node scripts/generate-media-pdfs.mjs dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint:js": "node --check public/assets/js/site.js && node --check public/assets/js/enquiry.js",
    "lint:css": "stylelint public/assets/css/fonts.css public/assets/css/hecavex.css",
    "generate:favicons": "node scripts/generate_favicons.mjs",
    "generate:social": "node scripts/generate_social_cards.mjs",
    "check:favicons": "node scripts/generate_favicons.mjs --check",
    "check:editorial-assets": "node scripts/check_editorial_assets.mjs",
    "validate": "node scripts/validate-content.mjs",
    "check:routes": "node scripts/check-route-parity.mjs dist",
    "check:performance": "node scripts/check_performance_budgets.mjs dist",
    "audit:site": "node scripts/audit-site.mjs dist",
    "audit:responsive": "node scripts/audit_responsive.mjs dist",
    "check:publication": "node scripts/check-publication-browser.mjs dist",
    "check:journeys": "node scripts/check-reader-journeys.mjs dist",
    "check:citations": "node scripts/check-citations.mjs dist",
    "check:media-kit": "node scripts/check-media-kit.mjs dist",
    "check:defensive-reuse": "node scripts/check-defensive-reuse.mjs dist",
    "check:consumer": "python scripts/test-investigation-consumer.py",
    "test": "node --test scripts/*.test.mjs",
    "check:evidence": "node scripts/check-retained-evidence.mjs",
    "verify": "npm test && npm run check:consumer && npm run lint:js && npm run lint:css && npm run check:evidence && npm run build && npm run check:routes && npm run check:performance && npm run audit:site && npm run audit:responsive && npm run check:publication && npm run check:journeys && npm run check:citations && npm run check:media-kit && npm run check:defensive-reuse"
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@astrojs/markdown-remark": "^7.2.2",
    "@types/node": "^26.2.0",
    "lightningcss": "^1.33.0",
    "playwright-core": "^1.62.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "latest",
    "yaml": "latest"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.2%",
    "not dead"
  ]
}
