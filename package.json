{
  "name": "hecavex-research",
  "version": "3.0.0",
  "description": "HECAVEX bilingual cyber threat intelligence publication",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && npm run check:favicons && npm run build:astro && npm run build:finalize",
    "build:astro": "astro check && astro build",
    "build:finalize": "node scripts/finalize-build.mjs dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint:js": "node --check public/assets/js/site.js",
    "lint:css": "stylelint public/assets/css/fonts.css public/assets/css/hecavex.css",
    "generate:favicons": "node scripts/generate_favicons.mjs",
    "generate:social": "node scripts/generate_social_cards.mjs",
    "check:favicons": "node scripts/generate_favicons.mjs --check",
    "validate": "node scripts/validate-content.mjs",
    "check:routes": "node scripts/check-route-parity.mjs dist",
    "check:performance": "node scripts/check_performance_budgets.mjs dist",
    "test:performance": "node --test scripts/check_performance_budgets.test.mjs",
    "audit:site": "node scripts/audit-site.mjs dist",
    "audit:responsive": "node scripts/audit_responsive.mjs dist",
    "test": "node --test tests/*.test.mjs scripts/check_performance_budgets.test.mjs",
    "verify": "npm run lint:js && npm run lint:css && npm run test && npm run build && npm run check:routes && npm run check:performance && npm run audit:site && npm run audit:responsive"
  },
  "dependencies": {
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@astrojs/markdown-remark": "^7.2.2",
    "@types/node": "^26.2.0",
    "playwright-core": "^1.62.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "latest",
    "yaml": "latest"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.2%",
    "not dead"
  ]
}
