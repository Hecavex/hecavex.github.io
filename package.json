{
  "name": "hecavex-site",
  "version": "2.0.0",
  "description": "HECAVEX bilingual cyber threat intelligence publication",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm test",
    "lint:js": "node --check assets/js/site.js",
    "lint:css": "stylelint assets/css/hecavex.css",
    "audit:responsive": "node tools/audit_responsive.mjs _site",
    "test": "npm run lint:js && npm run lint:css",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "playwright-core": "^1.62.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.2%",
    "not dead"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [0, "always"]
    }
  }
}
